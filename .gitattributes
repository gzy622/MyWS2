# Stable cross-platform text normalization; Windows scripts override this below.
* text=auto eol=lf

# Web source, documentation, and configuration use LF.
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.css text eol=lf
*.cjs text eol=lf
*.gradle text eol=lf
*.html text eol=lf
*.java text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.xml text eol=lf
/android/gradlew text eol=lf

# Windows launchers and PowerShell tooling require CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Generated/native binary assets must never be normalized.
*.aab binary
*.apk binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
