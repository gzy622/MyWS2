{
  "name": "teacher-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Optional Capacitor Android packaging for the teacher workbench demo",
  "scripts": {
    "sync:www": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-capacitor-www.ps1",
    "sync:android": "npm run sync:www && npx cap sync android",
    "build:apk": "npm run sync:android && cd android && .\\gradlew.bat assembleDebug",
    "deploy:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-apk.ps1",
    "preview:native": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/preview-native.ps1",
    "code:id": "node ./scripts/content-id.cjs .",
    "sync:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-phone.ps1",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
